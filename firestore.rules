rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function validItem(d) {
      return d.name is string && d.name.size() >= 2 && d.name.size() <= 80
        && d.description is string && d.description.size() <= 500
        && d.price is number && d.price > 0 && d.price <= 100000
        && d.categoryId is string && d.isAvailable is bool && d.isFeatured is bool
        && d.foodType in ['veg', 'jain'] && d.imageUrl is string;
    }

    // Public menu: anyone can read, only admins can write.
    match /foodItems/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && validItem(request.resource.data);
      allow delete: if isAdmin();
    }
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Admin list is managed only from the Firebase console. Users may check their own entry.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
